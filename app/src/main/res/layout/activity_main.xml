<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="#1E3A8A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="🤖"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Support"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="● Online • Usually replies instantly"
                android:textColor="#BBF7D0"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnClearChat"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#FFFFFF"
            android:text="Clear"
            android:textAllCaps="false"
            android:textColor="#1E3A8A"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ================= WELCOME CARD ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bot_message"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How can we help? 👋"
            android:textColor="#172554"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ask us anything about your orders, delivery, payments or refunds."
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- ================= CHAT AREA ================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp" />


    <!-- ================= TYPING INDICATOR ================= -->

    <LinearLayout
        android:id="@+id/typingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Support assistant is typing..."
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ================= QUICK ACTIONS ================= -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnOrder"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_action"
                android:text="📦 Orders"
                android:textAllCaps="false"
                android:textColor="#1D4ED8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDelivery"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_action"
                android:text="🚚 Delivery"
                android:textAllCaps="false"
                android:textColor="#1D4ED8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRefund"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_action"
                android:text="💳 Refund"
                android:textAllCaps="false"
                android:textColor="#1D4ED8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnHelp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_action"
                android:text="❓ Help"
                android:textAllCaps="false"
                android:textColor="#1D4ED8"
                android:textSize="13sp" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ================= MESSAGE INPUT ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/editTextMessage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Type your message..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#172554"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#2563EB"
            android:gravity="center"
            android:text="➤"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

    </LinearLayout>

</LinearLayout>